          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "available"
        ],
        "title": "BreakerState",
        "description": "Per-pod circuit-breaker state. Only readable when the pod is in-process\n(embedded mode); in distributed mode the pod runs on a worker, so the gateway\nreports ``available: false`` with a note."
      },
      "DeviceDetail": {
        "properties": {
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "transport": {
            "type": "string",
            "title": "Transport"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "pod_active": {
            "type": "boolean",
            "title": "Pod Active"
          },
          "last_check": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Check"
          },
          "rate_limit_rps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate Limit Rps"
          },
          "spec_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Url"
          },
          "spec_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Hash"
          },
          "auth_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auth Type"
          },
          "spawn_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spawn Error"
          },
          "worker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Id"
          },
          "tools_revision": {
            "type": "integer",
            "title": "Tools Revision",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "base_url",
          "transport",
          "reachable",
          "pod_active"
        ],
        "title": "DeviceDetail",
        "description": "Full device projection for the single-device read \u2014 a superset of\n:class:`DeviceSummary` adding the fields a detail/diagnostic view needs."
      },
      "DeviceDiagnostics": {
        "properties": {
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "spec_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Url"
          },
          "transport": {
            "type": "string",
            "title": "Transport"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "pod_active": {
            "type": "boolean",
            "title": "Pod Active"
          },
          "worker_id": {
