  "components": {
    "schemas": {
      "DeviceListResponse": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceSummary"
            },
            "type": "array",
            "title": "Devices"
          }
        },
        "type": "object",
        "required": [
          "devices"
        ],
        "title": "DeviceListResponse"
      },
      "DeviceSummary": {
        "properties": {
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "transport": {
            "type": "string",
            "title": "Transport"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "pod_active": {
            "type": "boolean",
            "title": "Pod Active"
          },
          "last_check": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Check"
          },
          "rate_limit_rps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate Limit Rps"
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "base_url",
          "transport",
          "reachable",
          "pod_active"
        ],
        "title": "DeviceSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OverviewCounts": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "active_pods": {
            "type": "integer",
            "title": "Active Pods"
          },
          "reachable": {
            "type": "integer",
            "title": "Reachable"
          },
          "unreachable": {
            "type": "integer",
            "title": "Unreachable"
          }
        },
        "type": "object",
        "required": [
          "total",
          "active_pods",
          "reachable",
          "unreachable"
        ],
        "title": "OverviewCounts"
      },
      "OverviewResponse": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "counts": {
            "$ref": "#/components/schemas/OverviewCounts"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceSummary"
            },
            "type": "array",
            "title": "Devices"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "counts",
          "devices"
        ],
        "title": "OverviewResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
