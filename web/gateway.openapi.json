            "title": "Spawn Error"
          },
          "breaker": {
            "$ref": "#/components/schemas/BreakerState"
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "mode",
          "base_url",
          "transport",
          "reachable",
          "pod_active",
          "has_manifest",
          "tool_count",
          "breaker"
        ],
        "title": "DeviceDiagnostics",
        "description": "\"Why is my device down?\" \u2014 a single read combining registry status, the\nlast check, spec/manifest state, the spawn error, and the circuit breaker\n(F-52)."
      },
      "DeviceListResponse": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceSummary"
            },
            "type": "array",
            "title": "Devices"
          }
        },
        "type": "object",
        "required": [
          "devices"
        ],
        "title": "DeviceListResponse"
      },
      "DeviceMutationResult": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "provisioning": {
            "type": "boolean",
            "title": "Provisioning"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDetail"
          }
        },
        "type": "object",
        "required": [
          "status",
          "provisioning",
          "device"
        ],
        "title": "DeviceMutationResult",
        "description": "Response for a register/update write: the write-time envelope plus the full\nresulting device, so a client gets the resource back without a follow-up GET."
      },
      "DeviceSummary": {
        "properties": {
          "hostname": {
            "type": "string",
