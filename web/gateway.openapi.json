                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Check Age Seconds"
          },
          "spec_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Hash"
          },
          "has_manifest": {
            "type": "boolean",
            "title": "Has Manifest"
          },
          "tool_count": {
            "type": "integer",
            "title": "Tool Count"
          },
          "tools_revision": {
            "type": "integer",
            "title": "Tools Revision",
            "default": 0
          },
          "spawn_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
