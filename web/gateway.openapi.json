  "components": {
    "schemas": {
      "BreakerState": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "fail_counter": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Counter"
          },
          "fail_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Max"
          },
