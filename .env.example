# Copy to .env and fill in. Used by docker-compose and local dev.

# Gateway API (the device-mcp-gateway). For local dev against a gateway on the host:
GATEWAY_URL=http://host.docker.internal:8000
# The gateway's management API version prefix. Default /v1; change only when the
# gateway introduces a new version (e.g. /v2).
GATEWAY_API_PREFIX=/v1
# An admin-role gateway API key (held by the BFF only, never sent to the browser).
GATEWAY_API_TOKEN=

# UI login passwords → role. Empty disables that role. These are the local
# break-glass / bootstrap accounts; keep at least the admin one even with SSO on.
UI_ADMIN_PASSWORD=admin
UI_VIEWER_PASSWORD=viewer

# Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=dev-insecure-change-me

# Tamper-evident audit (gateway F-57 model, ADR-0013 §9/§10). The BFF keeps its own chain
# because it records what the gateway cannot see — failed logins, and (once provider
# federation ships) which human was behind a proxied action.
#   AUDIT_PATH   empty → records still chain and go to stdout, but the chain restarts at
#                genesis every boot. Set it wherever the audit is meant to be evidence.
#   CONTENT_KEY  encrypts record content per tenant so offboarding is a key destruction,
#                not a row deletion. Generate:
#                  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                Empty → content in the clear and no crypto-shredding.
#   PSEUDONYM    keys the stable handles used for cross-plane (provider) actors. Empty →
#                the writer withholds the identity rather than emitting a reversible one.
AUDIT_PATH=
AUDIT_TENANT=default
AUDIT_CONTENT_KEY=
AUDIT_PSEUDONYM_KEY=

# Which tenant this deployment serves (ADR-0013 §4). Distinct from AUDIT_TENANT above,
# which selects a content key: this one is an AUTHORIZATION discriminator, consulted only
# to decide whether a provider operator's "act on tenant" grant names *this* stack. Empty
# (the default) admits no provider session at all, so a tenant-only deployment can leave
# it unset. Same name the gateway uses for the same concept (gateway.tenant_id).
TENANT_ID=

# Step-up behind the two ELEVATED provider grants (ADR-0013 §8/§11b). Only meaningful on a
# provider console. PROVIDER_STEP_UP_ACR is both requested as `acr_values` and required in
# the issued token's `acr` — an IdP may decline the step-up and issue anyway, so requesting
# it proves nothing. Empty (the default) disables the elevated grants entirely: with no
# context to verify there is nothing to check.
PROVIDER_STEP_UP_ACR=
PROVIDER_STEP_UP_REDIRECT_URL=      # e.g. https://console.example.com/auth/provider/step-up/callback
PROVIDER_GRANT_CLAIM=mcp_grant      # must match the gateway's per-issuer grant_claim
# Scopes the step-up requests so the IdP knows WHICH grant to mint (ADR-0013 §11c). No IdP
# will mint a grant from a request that never said what to mint, and a scope is the only
# carrier that survives to issuance. Template over {tenant} and {grant_class}; whitespace
# separates multiple scopes, so this factoring needs one registered scope per tenant plus
# one per class rather than one per combination. Empty disables the elevated grants.
# The scope only SELECTS — the gateway authorizes, by intersecting the tenant against the
# operator's directory entitlement.
PROVIDER_STEP_UP_SCOPE_TEMPLATE=    # e.g. mcp:tenant:{tenant} mcp:grant:{grant_class}

# Federated identity (OIDC SSO, ADR-0007). When OIDC_ENABLED is true the BFF runs an
# Authorization Code + PKCE login against the IdP and relays the signed-in user's access
# token upstream, so the GATEWAY authorizes the real user (configure gateway.oidc to match).
# Local passwords above remain available as break-glass.
OIDC_ENABLED=false
OIDC_ISSUER=                       # e.g. https://login.example.com/realms/corp
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                # omit for a public client (PKCE only)
OIDC_REDIRECT_URL=                 # must match IdP registration, e.g. https://ui.example.com/auth/oidc/callback
OIDC_SCOPES=openid profile email   # add the scope/resource that yields a gateway-audience access token
OIDC_POST_LOGIN_REDIRECT=/

# Monitoring sources (optional). When set, the BFF proxies them for the Monitoring
# view's critical-metric tiles (Prometheus) and recent-logs panel (Loki). Leave
# empty to lean entirely on central monitoring.
PROMETHEUS_URL=
LOKI_URL=
# Optional link to your central Grafana — surfaced in the Monitoring view.
GRAFANA_URL=
